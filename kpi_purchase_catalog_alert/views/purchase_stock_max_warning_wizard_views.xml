<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_stock_max_warning_wizard_form" model="ir.ui.view">
        <field name="name">purchase.stock.max.warning.wizard.form</field>
        <field name="model">purchase.stock.max.warning.wizard</field>
        <field name="arch" type="xml">
            <form string="Alerta de Stock Máximo">
                <div class="alert alert-warning d-flex align-items-center mb-3" role="alert">
                    <i class="fa fa-exclamation-triangle fa-2x me-3"/>
                    <div>
                        <h5 class="alert-heading mb-1">Inconsistencia en Cantidades Pedidas</h5>
                        <span>Se sugiere reducir las unidades para cumplir con el límite configurado.</span>
                    </div>
                </div>
                <field name="message" widget="text" readonly="1" nolabel="1" class="text-dark fw-bold"/>
                <footer>
                    <button string="Entendido y Continuar" name="action_continue" type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>