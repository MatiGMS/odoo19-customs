<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_banner" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.banner</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Inyectamos el banner justo antes de la hoja del documento (sheet) -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-2" role="alert" invisible="not max_qty_warning_msg">
                    <h4 class="alert-heading"><i class="fa fa-warning"/> Advertencia de Stock Máximo</h4>
                    <!-- El widget html renderiza la lista de productos que armamos en Python -->
                    <field name="max_qty_warning_msg" widget="html" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>