<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_max_qty_wizard_form" model="ir.ui.view">
        <field name="name">purchase.max.qty.wizard.form</field>
        <field name="model">purchase.max.qty.wizard</field>
        <field name="arch" type="xml">
            <form string="Exceso de Cantidad Máxima">
                <sheet>
                    <field name="purchase_id" invisible="1"/>
                    <div class="alert alert-danger" role="alert">
                        Estás a punto de confirmar una orden que incumple las reglas de reabastecimiento:
                    </div>
                    <field name="message" widget="html"/>
                </sheet>
                <footer>
                    <button name="action_confirm_anyway" string="Confirmar de todos modos" type="object" class="btn-danger"/>
                    <button string="Cancelar y Revisar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>