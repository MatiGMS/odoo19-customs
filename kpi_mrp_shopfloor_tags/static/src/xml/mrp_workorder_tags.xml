<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- En Odoo Shop Floor el template base de la ficha es mrp_workorder.Operation o mrp_workorder.Workorder -->
    <t t-inherit="mrp_workorder.Operation" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'card-body')]/*[1]" position="before">
            <t t-if="record.tag_badges_html">
                <div t-out="record.tag_badges_html"/>
            </t>
        </xpath>
    </t>

    <!-- Compatibilidad si el template en tu build se llama mrp_workorder.Workorder -->
    <t t-inherit="mrp_workorder.Workorder" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'card-body')]/*[1]" position="before">
            <t t-if="record.tag_badges_html">
                <div t-out="record.tag_badges_html"/>
            </t>
        </xpath>
    </t>

</templates>