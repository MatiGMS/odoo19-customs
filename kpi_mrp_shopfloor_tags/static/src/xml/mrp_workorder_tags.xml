<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Extensión de la tarjeta en la terminal de taller -->
    <t t-inherit="mrp_workorder.Operation" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('card-body')]/*[1]" position="before">
            <div class="o_shopfloor_tags_section d-flex flex-wrap gap-1 mb-2" 
                 t-if="record.production_tags and record.production_tags.length">
                <t t-foreach="record.production_tags" t-as="tag" t-key="tag.id">
                    <span t-attf-class="badge rounded-pill o_shopfloor_tag_badge o_tag_color_{{ tag.color }}">
                        <i class="fa fa-tag me-1 opacity-75"/>
                        <t t-esc="tag.name"/>
                    </span>
                </t>
            </div>
        </xpath>
    </t>

    <!-- Compatibilidad de selector si el template se llama Workorder -->
    <t t-inherit="mrp_workorder.Workorder" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('card-body')]/*[1]" position="before">
            <div class="o_shopfloor_tags_section d-flex flex-wrap gap-1 mb-2" 
                 t-if="record.production_tags and record.production_tags.length">
                <t t-foreach="record.production_tags" t-as="tag" t-key="tag.id">
                    <span t-attf-class="badge rounded-pill o_shopfloor_tag_badge o_tag_color_{{ tag.color }}">
                        <i class="fa fa-tag me-1 opacity-75"/>
                        <t t-esc="tag.name"/>
                    </span>
                </t>
            </div>
        </xpath>
    </t>

</templates>