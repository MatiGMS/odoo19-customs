<odoo>
    <record id="view_order_form_print_all_documents" model="ir.ui.view">
        <field name="name">sale.order.form.print.all.documents</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_quotation_send']" position="after">
                <button name="action_print_all_documents"
                        type="object"
                        string="Imprimir todo"
                        class="btn-primary"
                        data-hotkey="p"/>
            </xpath>
        </field>
    </record>
</odoo>